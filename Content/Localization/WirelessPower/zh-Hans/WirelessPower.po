#. Key:	Milestone_Mk1_Name
#. SourceLocation:	Mods/WirelessPower/Source/WirelessPower/Registration.cpp(810)
#: Mods/WirelessPower/Source/WirelessPower/Registration.cpp(810)
msgid ",Milestone_Mk1_Name"
msgstr "无线电力 Mk1"

#. Key:	Milestone_Mk1_Desc
#. SourceLocation:	Mods/WirelessPower/Source/WirelessPower/Registration.cpp(811)
#: Mods/WirelessPower/Source/WirelessPower/Registration.cpp(811)
msgid ",Milestone_Mk1_Desc"
msgstr "无线电力 1 级。建造菜单中解锁电力继电器 Mk1、电力转换器与无线电杆 Mk1；该里程碑同时推进科技层。共享同一 ID 的无线节点会在射程内互相供电，节点之间无需电缆。"

#. Key:	Milestone_Mk2_Name
#. SourceLocation:	Mods/WirelessPower/Source/WirelessPower/Registration.cpp(820)
#: Mods/WirelessPower/Source/WirelessPower/Registration.cpp(820)
msgid ",Milestone_Mk2_Name"
msgstr "无线电力 Mk2"

#. Key:	Milestone_Mk2_Desc
#. SourceLocation:	Mods/WirelessPower/Source/WirelessPower/Registration.cpp(821)
#: Mods/WirelessPower/Source/WirelessPower/Registration.cpp(821)
msgid ",Milestone_Mk2_Desc"
msgstr "无线电力 2 级：建造菜单中解锁电力继电器 Mk2（48 米）与无线电杆 Mk2（24 米）。"

#. Key:	Milestone_Mk3_Name
#. SourceLocation:	Mods/WirelessPower/Source/WirelessPower/Registration.cpp(829)
#: Mods/WirelessPower/Source/WirelessPower/Registration.cpp(829)
msgid ",Milestone_Mk3_Name"
msgstr "无线电力 Mk3"

#. Key:	Milestone_Mk3_Desc
#. SourceLocation:	Mods/WirelessPower/Source/WirelessPower/Registration.cpp(830)
#: Mods/WirelessPower/Source/WirelessPower/Registration.cpp(830)
msgid ",Milestone_Mk3_Desc"
msgstr "解锁电力传送塔：一条射程 4800 米的视线连接链路，可以跨越峡谷送电。同时把无线电力推进到 3 级（电力继电器 Mk3 96 米、无线电杆 Mk3 48 米，二者此前已解锁）。"

#. Key:	Building_RelayMk1
